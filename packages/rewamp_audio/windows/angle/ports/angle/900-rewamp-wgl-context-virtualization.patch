-    return new ContextWGL(state, errorSet, mRenderer);
+    std::shared_ptr<RendererWGL> renderer = mRenderer;
+    EGLAttrib virtualizationGroup =
+        attribs.get(EGL_CONTEXT_VIRTUALIZATION_GROUP_ANGLE, EGL_DONT_CARE);
+    if (virtualizationGroup != EGL_DONT_CARE)
+    {
+        renderer = mVirtualizationGroups[virtualizationGroup].lock();
+        if (!renderer)
+        {
+            // Always in the MAIN context's share list: every context of this display shares
+            // textures globally (displayTextureShareGroup), and a frontend share group spanning
+            // two renderers needs their native objects to be visible to both.
+            egl::Error error = createRenderer(mRenderer->getContext(), &renderer);
+            if (error.isError())
+            {
+                ERR() << "Failed to create a virtualization group renderer: "
+                      << error.getMessage();
+                return nullptr;
+            }
+            mVirtualizationGroups[virtualizationGroup] = renderer;
+        }
+    }
+    return new ContextWGL(state, errorSet, renderer);
 }
 
