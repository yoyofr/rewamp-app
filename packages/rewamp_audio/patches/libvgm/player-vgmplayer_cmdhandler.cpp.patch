+// ---- VGM v3 extension commands (ES5505/ES5506 + ES5510, ZSG-2 + TMS57002) ----
+// The ES5510 (chip 0x35) is emulated inside the ES5506 device (chip 0x25) it is wired to, the TMS57002
+// (chip 0x36) inside the ZSG-2 device (chip 0x34). The v3 commands are translated to the device's
+// extension entry points (see es5506.h / zsg2.h).
+
+static void SendES5506Ext(VGMPlayer::CHIP_DEVICE* cDev, UINT8 sub, UINT8 aa, UINT8 data)
+{
+	if (cDev != NULL && cDev->writeExt != NULL)
+		cDev->writeExt(cDev->base.defInf.dataPtr, (sub << 8) | aa, data);
+}
+
+static void SendES5510(VGMPlayer::CHIP_DEVICE* cDev, UINT8 sub, UINT8 aa, UINT8 data)
+{
+	if (cDev != NULL && cDev->writeEsp != NULL)
+		cDev->writeEsp(cDev->base.defInf.dataPtr, (sub << 8) | aa, data);
+}
+
+static void SendES5506Gain(VGMPlayer::CHIP_DEVICE* cDev, UINT8 cc, UINT16 gain)
+{
+	if (cDev != NULL && cDev->writeGain != NULL)
+		cDev->writeGain(cDev->base.defInf.dataPtr, cc, gain);
+}
+
+static void SendZSG2Ext(VGMPlayer::CHIP_DEVICE* cDev, UINT8 sub, UINT8 aa, UINT16 data)
+{
+	if (cDev != NULL && cDev->writeM16 != NULL)
+		cDev->writeM16(cDev->base.defInf.dataPtr, (sub << 8) | aa, data);
+}
+
+void VGMPlayer::Cmd_V3_ES5506_Bank(void)
+{
+	// 49 vv bb: voice vv (bits 0-4, bit 7 = 2nd chip) reads with an external bank of bb x 1M words
+	SendES5506Ext(GetDevicePtr(0x25, fData[0x01] >> 7), 0x00, fData[0x01] & 0x1F, fData[0x02]);
+}
+
+void VGMPlayer::Cmd_V3_ES5506_RgnMap(void)
+{
+	// 4A rr mm: region rr (bits 0-1, bit 7 = 2nd chip) reads region (mm & 3) at word offset (mm >> 2) x 1M
+	CHIP_DEVICE* cDev = GetDevicePtr(0x25, fData[0x01] >> 7);
+	UINT8 rr = fData[0x01] & 0x03;
+	SendES5506Ext(cDev, 0x01, rr, fData[0x02] >> 2);
+	SendES5506Ext(cDev, 0x02, rr, fData[0x02] & 0x03);
+}
+
+void VGMPlayer::Cmd_V3_ES5510_Halt(void)
+{
+	// 4B cc hh: ESPHALT line of ES5510 cc (bit 7 = 2nd chip)
+	SendES5510(GetDevicePtr(0x25, fData[0x01] >> 7), 0x01, 0x00, fData[0x02] ? 1 : 0);
+}
+
+void VGMPlayer::Cmd_V3_ES5510_Host(void)
+{
+	// CC cc aa dd: ES5510 host register write
+	SendES5510(GetDevicePtr(0x25, fData[0x01] >> 7), 0x00, fData[0x02], fData[0x03]);
+}
+
+void VGMPlayer::Cmd_V3_ZSG2_Ctrl(void)
+{
+	// 4C cc rr: bit 0 = ZSG-2 reset pulse
+	if (fData[0x02] & 0x01)
+		SendZSG2Ext(GetDevicePtr(0x34, fData[0x01] >> 7), 0x0A, 0x00, 0);
+}
+
+void VGMPlayer::Cmd_V3_TMS57002_Data(void)
+{
+	// 4D cc dd: TMS57002 host data write
+	SendZSG2Ext(GetDevicePtr(0x34, fData[0x01] >> 7), 0x04, 0x00, fData[0x02]);
+}
+
+void VGMPlayer::Cmd_V3_TMS57002_Lines(void)
+{
+	// 4E cc ll: bit 2 set = DSP reset pulse (bits 0-1 ignored), else bit 0 = PLOAD, bit 1 = CLOAD levels
+	CHIP_DEVICE* cDev = GetDevicePtr(0x34, fData[0x01] >> 7);
+	if (fData[0x02] & 0x04)
+		SendZSG2Ext(cDev, 0x09, 0x00, 0);
+	else
+		SendZSG2Ext(cDev, 0x05, 0x00, fData[0x02] & 0x03);
+}
+
+void VGMPlayer::Cmd_V3_TMS57002_PreRun(void)
+{
+	// CD cc nnnn: run nnnn sample periods of the DSP program with silent inputs (big endian)
+	SendZSG2Ext(GetDevicePtr(0x34, fData[0x01] >> 7), 0x08, 0x00, ReadBE16(&fData[0x02]));
+}
+
+void VGMPlayer::Cmd_V3_ZSG2_Reg(void)
+{
+	// E4 oooo dddd: ZSG-2 register write, 16-bit word offset (bit 15 = 2nd chip), big endian
+	UINT16 ofs = ReadBE16(&fData[0x01]);
+	SendZSG2Ext(GetDevicePtr(0x34, ofs >> 15), (ofs >> 8) & 0x03, ofs & 0xFF, ReadBE16(&fData[0x03]));
+}
+
+void VGMPlayer::Cmd_V3_Route(void)
+{
+	// E2 dd ii ss cc: serial input ii of DSP dd takes output channel cc of chip ss (0xFF = none)
+	UINT8 dd = fData[0x01];
+	UINT8 ii = fData[0x02];
+	UINT8 ss = fData[0x03];
+	UINT8 cc = fData[0x04];
+	
+	switch(dd & 0x7F)
+	{
+	case 0x35:	// ES5510: inputs come from the ES5506 it is attached to
+		if (cc != 0xFF && ss != (0x25 | (dd & 0x80)))
+			break;
+		SendES5510(GetDevicePtr(0x25, dd >> 7), 0x02, ii, cc);
+		break;
+	case 0x36:	// TMS57002 of the ZSG-2 device: fixed wiring, ZSG-2 output n -> DSP input n
+		if (ss != (0x34 | (dd & 0x80)) || ii != cc)
+			emu_logf(&_logger, PLRLOG_WARN, "Unsupported TMS57002 routing: input %u <- chip 0x%02X output %u\n", ii, ss, cc);
+		break;
+	}
+}
+
+void VGMPlayer::Cmd_V3_Gain(void)
+{
+	// E3 tt cc gggg: gain of output channel cc of chip tt into the mix, 8.8 big endian (even = left, odd = right)
+	UINT8 tt = fData[0x01];
+	UINT8 cc = fData[0x02];
+	UINT16 gain = ReadBE16(&fData[0x03]);
+	
+	switch(tt & 0x7F)
+	{
+	case 0x25:	// ES5505/ES5506: channels 0-11, 0xFE/0xFF = direct mix bus left/right
+		if (cc < 12)
+			SendES5506Gain(GetDevicePtr(0x25, tt >> 7), cc, gain);
+		else if (cc == 0xFE || cc == 0xFF)
+			SendES5506Gain(GetDevicePtr(0x25, tt >> 7), 0x12 | (cc & 1), gain);
+		break;
+	case 0x35:	// ES5510: serial outputs 6/7
+		if (cc == 6 || cc == 7)
+			SendES5506Gain(GetDevicePtr(0x25, tt >> 7), 0x10 | (cc & 1), gain);
+		break;
+	case 0x34:	// ZSG-2: outputs 0-3 straight to the mix (DSP bypass)
+		if (cc < 4)
+			SendZSG2Ext(GetDevicePtr(0x34, tt >> 7), 0x06, ((cc & 1) ? 0x24 : 0x20) + cc, gain);
+		break;
+	case 0x36:	// TMS57002: outputs 0-3 to the mix, 0x80-0x83 = serial input attenuation
+		if (cc < 4)
+			SendZSG2Ext(GetDevicePtr(0x34, tt >> 7), 0x06, ((cc & 1) ? 0x14 : 0x10) + cc, gain);
+		else if (cc >= 0x80 && cc < 0x84)
+			SendZSG2Ext(GetDevicePtr(0x34, tt >> 7), 0x06, cc & 0x03, gain);
+		break;
+	}
+}
+
 void VGMPlayer::Cmd_Ofs16_Data8(void)
 {
 	UINT8 chipType = _CMD_INFO[fData[0x00]].chipType;
@@ -1113,7 +1276,9 @@ void VGMPlayer::Cmd_Ofs8_Data16(void)
 	if (cDev == NULL || cDev->writeD16 == NULL)
 		return;
 	
-	UINT16 value = ReadLE16(&fData[0x02]);
+	// 0xD6 aa ddee: the 16-bit value is stored big endian (dd = byte lane aa|0, ee = byte lane aa|1),
+	// matching the MAME VGM logger and the C352 command.
+	UINT16 value = ReadBE16(&fData[0x02]);
 	cDev->writeD16(cDev->base.defInf.dataPtr, fData[0x01] & 0x7F, value);
 	return;
 }
