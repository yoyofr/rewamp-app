+INLINE UINT32 ReadBE32(const UINT8* data)
+{
+	return	((UINT32)data[0x00] << 24) | ((UINT32)data[0x01] << 16) |
+			((UINT32)data[0x02] <<  8) | ((UINT32)data[0x03] <<  0);
+}
