+long long Player::lastEventMs() const
+{
+  if (!impl_->opened) return 0;
+  sS32 *tl = nullptr;
+  const sU32 n = const_cast<V2MPlayer &>(impl_->seq).CalcPositions(&tl);
+  long long ms = 0;
+  if (tl && n > 0) ms = (long long)tl[2 * (n - 1)];
+  free(tl);
+  return ms;
+}
