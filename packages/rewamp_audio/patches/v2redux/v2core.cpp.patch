       }
       pk *= chgain;
       if (pk > inst->chanPeak[chanIndex]) inst->chanPeak[chanIndex] = pk;
+
+      //YOYOFR (rewamp): oscilloscope par voix. Même signal que le mètre
+      //ci-dessus — la contribution post-FX de ce canal — décimée en 8 bits dans
+      //l'anneau que le plugin dimensionne AVANT le premier rendu. L'anneau est
+      //circulaire: le lecteur doit l'être aussi, sinon la trace se met à plat
+      //après chaque bouclage. Le rendu est déjà à 44100, donc 1:1.
+      if (chanIndex < SOUND_MAXVOICES_BUFFER_FX && m_voice_buff[chanIndex])
+      {
+        const sInt mask = SOUND_BUFFER_SIZE_SAMPLE * 4 * 2 - 1;
+        int64_t ptr = m_voice_current_ptr[chanIndex];
+        for (sInt i = 0; i < nsamples; i++)
+        {
+          const sF32 mono = (chan[i].l + chan[i].r) * 0.5f * chgain;
+          int v = (int)(mono * 127.0f);
+          if (v > 127) v = 127; else if (v < -128) v = -128;
+          m_voice_buff[chanIndex][(ptr >> MODIZER_OSCILLO_OFFSET_FIXEDPOINT) & mask] =
+              (signed char)v;
+          ptr += 1 << MODIZER_OSCILLO_OFFSET_FIXEDPOINT;
+        }
+        while ((ptr >> MODIZER_OSCILLO_OFFSET_FIXEDPOINT) >= SOUND_BUFFER_SIZE_SAMPLE * 4 * 2)
+          ptr -= (int64_t)(SOUND_BUFFER_SIZE_SAMPLE * 4 * 2) << MODIZER_OSCILLO_OFFSET_FIXEDPOINT;
+        m_voice_current_ptr[chanIndex] = ptr;
+      }
     }
 
