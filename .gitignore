packages/rewamp_audio/macos/Classes/rewamp_channel_data.c
packages/rewamp_audio/macos/Classes/rewamp_vgm_impl.mm
packages/rewamp_audio/ios/Classes/vgm_cores/
packages/rewamp_audio/ios/Classes/rewamp_channel_data.c
packages/rewamp_audio/ios/Classes/rewamp_vgm_impl.mm
packages/rewamp_audio/ios/Classes/rewamp_sid_impl.mm
packages/rewamp_audio/ios/Classes/sid_cores/
packages/rewamp_audio/macos/Classes/nsfplay_cores/
packages/rewamp_audio/macos/Classes/rewamp_nsfplay_impl.mm
packages/rewamp_audio/ios/Classes/nsfplay_cores/
packages/rewamp_audio/ios/Classes/rewamp_nsfplay_impl.mm
packages/rewamp_audio/macos/Classes/gbsplay_cores/
packages/rewamp_audio/macos/Classes/rewamp_gbsplay_impl.m
packages/rewamp_audio/ios/Classes/gbsplay_cores/
packages/rewamp_audio/ios/Classes/rewamp_gbsplay_impl.m
packages/rewamp_audio/macos/Classes/highlyexp_cores/
packages/rewamp_audio/macos/Classes/rewamp_highlyexp_impl.m
packages/rewamp_audio/ios/Classes/highlyexp_cores/
packages/rewamp_audio/ios/Classes/rewamp_highlyexp_impl.m
# Catch-all for every prepare_command-generated wrapper (impl shims + per-core
# dirs), so new decoders don't need a new ignore line each. EVERY generated
# wrapper in Classes/ is named rewamp_<plugin>_*.{c,cpp,m,mm} (plugin glue, core
# shims like rewamp_v2m_ronan.cpp, rewamp_asap_core.c) or lives in a *_cores/ dir.
# The ONLY hand-written committed sources in Classes/ are RewampAudioPlugin.* and
# rewamp_audio.c — the latter is re-included below via a ! un-ignore.
packages/rewamp_audio/ios/Classes/rewamp_*.c
packages/rewamp_audio/ios/Classes/rewamp_*.cpp
packages/rewamp_audio/ios/Classes/rewamp_*.m
packages/rewamp_audio/ios/Classes/rewamp_*.mm
packages/rewamp_audio/macos/Classes/rewamp_*.c
packages/rewamp_audio/macos/Classes/rewamp_*.cpp
packages/rewamp_audio/macos/Classes/rewamp_*.m
packages/rewamp_audio/macos/Classes/rewamp_*.mm
!packages/rewamp_audio/ios/Classes/rewamp_audio.c
!packages/rewamp_audio/macos/Classes/rewamp_audio.c
packages/rewamp_audio/ios/Classes/*_cores/
packages/rewamp_audio/macos/Classes/*_cores/

# Xcode SwiftPM resolved-package lockfiles (regenerated per machine).
**/xcshareddata/swiftpm/Package.resolved

# Misc
.DS_Store
*.log

# Vendored ffmpeg-kit prebuilt (headers + .so). Currently UNUSED — builds force
# ffmpeg OFF — and the .so are never committed, so the headers alone are useless.
# Ignore the whole tree (same as the unused MetalANGLE vendor above); re-download
# the full prebuilt when reviving a real ffmpeg integration.
packages/rewamp_audio/third_party/ffmpeg-kit/

# ── Résidu de build des arbres vendorés ─────────────────────────────────────
# 276 fichiers (17,3 Mo) étaient entrés au dépôt avec les snapshots amont:
# objets compilés, comptabilité d'automake, cache d'autoconf, et un arbre de
# binaires de test du pilote USBSID de libsidplayfp. Aucun build ne les
# touchait — nos arbres se compilent par CMake et par les podspecs, jamais par
# autotools — et un `.o` versionné n'apprend rien à personne.
#
# Ces règles ne servent pas au quotidien mais au PROCHAIN re-vendorage: c'est
# lui qui les a introduits, et c'est lui qui les réintroduirait.
*.o
*.a
*.so
*.lo
*.la
*.Plo
*.Po
*.dirstamp
**/.deps/
**/autom4te.cache/
packages/rewamp_audio/third_party/libsidplayfp/libsidplayfp/src/builders/usbsid-builder/driver/test/build/

# Fichiers d’échange vim (`.<nom>.swp` et consorts) — jamais versionnés.
*.swp
*.swo

# flatpak: artefacts de build locaux (scripts/flatpak/)
scripts/flatpak/.build/
scripts/flatpak/.flatpak-builder/
