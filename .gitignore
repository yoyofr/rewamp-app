# ┌───────────────────────────────────────────────────────────────────────────┐
# │ GOLDEN RULE: keep this file current. `pod install` / builds generate wrapper │
# │ files under packages/rewamp_audio/{ios,macos}/Classes/ (rewamp_*.{c,cpp,m,mm}│
# │ + *_cores/). After adding a decoder or wiring, run `git status` and confirm  │
# │ no generated/build artifact shows up untracked — if it does, add a rule here │
# │ (broad glob, not per-file). Only hand-written sources belong in the repo.    │
# └───────────────────────────────────────────────────────────────────────────┘

# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins
**/.flutter-plugins-dependencies
.pub-cache/
.pub/
*.lock.bak

# iOS / macOS
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/ServiceDefinitions.json
**/xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/

# Android
**/.gradle/
**/local.properties
**/.cxx/
**/*.iml

# Linux / Windows desktop build
**/flutter/ephemeral/

# Built native libraries (regenerated by scripts/build_libopenmpt_*.sh)
packages/rewamp_audio/build/
packages/rewamp_audio/macos/Libs/
packages/rewamp_audio/ios/Libs/

