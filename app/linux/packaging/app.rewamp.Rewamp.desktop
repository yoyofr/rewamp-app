[Desktop Entry]
Type=Application
Name=Rewamp
GenericName=Music Player
Comment=Chiptune, tracker and console music player
Exec=rewamp %F
Icon=app.rewamp.Rewamp
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=chiptune;tracker;module;demoscene;emulation;SID;MOD;NSF;SPC;VGM;Amiga;
StartupNotify=true
StartupWMClass=app.rewamp.Rewamp
# Only the types shared-mime-info actually knows are listed: declaring a type
# the system DB ignores never triggers an association, and claiming the common
# audio types (audio/mpeg, audio/flac…) would put Rewamp in front of the
# desktop's own player for music it is not here for.
MimeType=audio/x-mod;audio/x-s3m;audio/x-it;audio/x-xm;audio/x-stm;audio/prs.sid;audio/x-psf;audio/x-minipsf;audio/midi;
