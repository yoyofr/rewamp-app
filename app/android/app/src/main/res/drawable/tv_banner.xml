<?xml version="1.0" encoding="utf-8"?>
<!-- Bannière du lanceur Android TV (320×180 dp, exigée par LEANBACK_LAUNCHER):
     le premier plan de l'icône adaptative centré sur sa couleur de fond. À
     remplacer par une bannière dessinée (logo + nom) quand il y en aura une. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background"/>
            <size android:width="320dp" android:height="180dp"/>
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
