per_frame_init_1=i=0; loop (5000,i[0]=0; gmem[i]=0; i+=1;);
per_frame_init_2=octaves=3; minbpm=75; maxbpm=200; nres_oct=60; 
per_frame_init_3=nres_extra=nres_oct/log(2)*log(maxbpm/minbpm/2);
per_frame_init_4=nres=nres_oct*octaves+nres_extra;
per_frame_init_5=bstep = log(2)/nres_oct;
per_frame_init_6=nres_out = ceil(nres_oct+nres_extra); //int is necessary !
per_frame_init_7=
per_frame_init_8=i=0;
per_frame_init_9=loop (nres,
per_frame_init_10= //precalculate BPM
per_frame_init_11=  (8*i)[3]=minbpm*exp(i*bstep); 
per_frame_init_12= //precalculate weighting
per_frame_init_13=  if (i<=nres_out,(8*i)[4]=min(2,1+sin($pi*i/nres_out)*3)/2,0);; 
per_frame_init_14=i+=1); 
per_frame_init_15=
per_frame_init_16=tm1_=tm2_=tm3_=tm4_=tm1=tm2=tm3=tm4=rand(8);;
per_frame_init_17=bi=bi2=bi3=bi4=bi5=0;
per_frame_init_18=quali=10;
per_frame_1=//Martin/Nitorami - DFT based BPM identification
per_frame_2=dec_m=exp(-2*dt);
per_frame_3=vol=2*bass_att+mid_att+treb_att;
per_frame_4=vol_ = vol_*dec_m + vol*(1-dec_m);
per_frame_5=
per_frame_6=dt=1/fps; 
per_frame_7=tcorr = (dt - dt_);
per_frame_8=dt_= dt;
per_frame_9=treal += dt + tcorr*38;
per_frame_10=exc=vol;
per_frame_11=d0= exp(-1.5*dt);
per_frame_12=i=0; avg = 0;
per_frame_13=loop (nres,
per_frame_14=  n = 8*i;
per_frame_15=  w = 2*$pi/60*n[3];
per_frame_16=  d = 1-dt*w*0.013; 
per_frame_17=  arg = treal*w + tcorr*15000;
per_frame_18=  n[1] = n[1]*d +exc*cos(arg)*(1-d); 
per_frame_19=  n[2] = n[2]*d +exc*sin(arg)*(1-d); 
per_frame_20=  if (i<nres_out, 
per_frame_21=    n2 = 8*(i+nres_oct);
per_frame_22=    n4 = 8*(i+nres_oct*2);
per_frame_23=    sum = sqrt (sqr(n[1])+sqr(n[2]) + sqr(n2[1])+sqr(n2[2]) + sqr(n4[1])+sqr(n4[2]));
per_frame_24=    avg += sum;
per_frame_25=    n[0]= n[0]*d0+sum*(1-d0)*n[4];
per_frame_26=    if (n[0]>(8*promax)[0], promax=max(2,min(nres_out-2,i));,0); 
per_frame_27=  ,0);
per_frame_28=i += 1;);
per_frame_29=avg_ = avg_*d0 + (1-d0)*avg/nres_out;
per_frame_30=
per_frame_31=m8 = 8*maxind;
per_frame_32=wait += abs(m8[0]-(8*promax)[0])*dt*100; 
per_frame_33=if (wait>abs(promax-maxind)*80/nres_oct, maxind=promax; wait = 0,0);
per_frame_34=
per_frame_35=//OUTPUT
per_frame_36=BPM  = m8[3]; // BPM in nres_out discrete steps
per_frame_37=BPMtime += BPM/60*dt;
per_frame_38=d=exp(-dt);
per_frame_39=quali= quali*d + (1-d)*min (4,max(0,m8[0]*2.5-0.5));
per_frame_40=
per_frame_41=sb = sin(BPMTime*2*$pi);
per_frame_42=is_beat = sb*osb<0;
per_frame_43=osb=sb;
per_frame_44=if (is_beat,
per_frame_45=  bi += 1;
per_frame_46=  bi2 += (bi%4==0);
per_frame_47=  bi3 += (bi%4==0)*sign(r1);
per_frame_48=  bi4 += (bi%2==1)*sign(r2);
per_frame_49=  bi5  += (bi%15==0);
per_frame_50=,0);
per_frame_51=mv = sin(tm2)>0.;
per_frame_52=bi3 *= mv;
per_frame_53=bi4 *= mv;
per_frame_54=
per_frame_55=rota = mx* (sin(tm2_*4)>0);
per_frame_56=
per_frame_57=//bandpass
per_frame_58=rep = 4;
per_frame_59=wg =2*$pi*2/rep; Q=.72; 
per_frame_60=wga=2*$pi*2/rep;
per_frame_61=loop (rep, //avoid instab. with low fps
per_frame_62=  mx = mx*(1-dt*wg/Q) + tmpx*dt;
per_frame_63=  tmpx += dt*sqr(wg)*(bi3/4-mx);
per_frame_64=  my = my*(1-dt*wg/Q) + tmpy*dt;
per_frame_65=  tmpy += dt*sqr(wg)*(bi4/4-my);
per_frame_66=
per_frame_67=  ma = ma*(1-dt*wga/Q) + tmpa*dt;
per_frame_68=  tmpa += dt*sqr(wga)*(rota-ma);
per_frame_69=);
per_frame_70=
per_frame_71=trig = is_beat && (bi%5==0);
per_frame_72=if (trig,
per_frame_73=  r1 = rand(2)-1;
per_frame_74=  r2 = rand(2)-1;
per_frame_75=  r3 = rand(2)-1;
per_frame_76=  r4 = rand(2)-1;
per_frame_77=,0);
per_frame_78=
per_frame_79=sp=BPM/125*dt;
per_frame_80=tm1 += (0.7+vol)/11*sp;
per_frame_81=tm2 += (0.8+vol*2)/13*sp;
per_frame_82=tm3 += (0.9+vol)/17*sp;
per_frame_83=tm4 += (1+vol)/23*sp;
per_frame_84=
per_frame_85=d=exp(-1*dt);
per_frame_86=tm1_ = d*tm1_ + (1-d)*tm1;
per_frame_87=tm2_ = d*tm2_ + (1-d)*tm2;
per_frame_88=tm3_ = d*tm3_ + (1-d)*tm3;
per_frame_89=tm4_ = d*tm4_ + (1-d)*tm4;
per_frame_90=
per_frame_91=q1 = tm1_;
per_frame_92=q2 = tm2_;
per_frame_93=q3 = tm3_;
per_frame_94=q4 = tm4_;
per_frame_95=
per_frame_96=q10 = BPMTime;
per_frame_97=q11 = sin(BPMTime/12*$pi)*1;
per_frame_98=q12 = max(0,quali);
per_frame_99=q15 = max(0,min(1,quali*2+8*sin(q3*.3))); //kstrength
per_frame_100=q16 = q15>0.95;
per_frame_101=q20 = mx;
per_frame_102=q21 = my;
per_frame_103=q22 = ma*2;
per_frame_104=
per_frame_105=
per_frame_106=q24 = bi;
per_frame_107=q25 = bi2;
per_frame_108=q26 = bi5%6+1;
per_frame_109=
per_frame_110=q32 = aspecty;
per_frame_111=rot = warp = 0;
per_frame_112=zoom = 1;
per_frame_113=monitor = q12;
warp_1=`#define sat saturate
warp_2=`float2 uv1,uv2,uv3;
warp_3=`
warp_4=`shader_body
warp_5=`{
warp_6=`float kk = 0.4+0.3*cos(q10*M_PI/10);
warp_7=`float2 uv0 = uv;
warp_8=`uv2 = (uv.yx-.5+0.5*rand_preset)*2;
warp_9=`ret = max(GetPixel(uv2)*kk,GetPixel(uv))*.91;
warp_10=`ret = ret  - 0.1*lum(GetBlur2(uv_orig)) - 0.01; 
warp_11=`
warp_12=`float s=3+(q25%8);
warp_13=`ret = max(ret,0.02*mid_att/length (sin(uv*s+q10*M_PI/2)));
warp_14=`
warp_15=`}
warp_16=`
comp_1=`sampler rand00;
comp_2=`sampler sampler_clouds;
comp_3=`float2 uv0, uv1, uv10, uv2, uv100, uv3;
comp_4=`float kmod_uv, inside, r1,r2,arg;
comp_5=`static const int anz = 6;
comp_6=`static const float size  = .25+.25*sin (q2/4), krad = 0.25, kstrength=q15, fullk=q16;
comp_7=`float3 ret0;
comp_8=`
comp_9=`shader_body
comp_10=`{
comp_11=`uv0 = uv;
comp_12=`uv1 = (uv-0.5)*aspect;
comp_13=`float k= sin(q10*M_PI*2-rad*8)*q12;
comp_14=`
comp_15=`r1 = length (uv1 * (1+float2 (cos(q10*6),sin(q10*6))*0.018*q12));
comp_16=`r2 = pow(r1/krad,2);
comp_17=`arg = 0.4*r2/(1.4-r2);
comp_18=`inside = r2<1;
comp_19=`kmod_uv = (inside ? (1+ arg):1/r1)*kstrength;
comp_20=`
comp_21=`uv1 = uv1*(1+kstrength*(kmod_uv-1))*1.2;
comp_22=`uv10 = uv1;
comp_23=`float a = M_PI*inside*fullk*q22;
comp_24=`uv1 = mul(uv1,float2x2(sin(a), cos(a),-cos(a),sin(a)));
comp_25=`
comp_26=`uv1+=(r2<1)*fullk*float2(q20,q21);
comp_27=`
comp_28=`uv1 += 0.5;
comp_29=`ret0 = 0;
comp_30=`for (int n = 0; n <= anz; n++)
comp_31=`{
comp_32=`  float ang1, ca, sa;
comp_33=`  ang1 = 3.14*n/anz*.05*q26;
comp_34=`  sincos (ang1,sa,ca);
comp_35=`  float mm = .5;
comp_36=`  uv1 = mul(uv1-mm,float2x2(ca,sa,-sa,ca))+mm;
comp_37=`  uv1 = float2(uv1.x, (abs(uv1.y-size)+size)) * (1+0.02*pow(sin(time*.11),3));
comp_38=`  uv1 = min(uv1,1-uv1);
comp_39=`  uv1 = .5 + (1.0 - abs( frac(uv1 * .5) * 2 - 1.0 )-.5); 
comp_40=`  uv3= uv1+.002*k +rad*exp(-q12)*kstrength*!inside;
comp_41=`  uv3 = .5 + (1.0 - abs( frac(uv3 * .5) * 2 - 1.0 )-.5); 
comp_42=`  ret0 += GetBlur1(uv3)/anz;
comp_43=`}
comp_44=`
comp_45=`
comp_46=`ret = lerp (GetPixel(uv3), ret0,0.6);
comp_47=`ret = lerp (ret, GetBlur1(uv3), kstrength*r2*r2*inside);
comp_48=`ret = lerp (ret, 2*GetBlur3(frac(uv3))*(1-rad),kstrength*!inside);
comp_49=`float d = (lum(GetPixel(uv3-texsize.zw))-lum(GetPixel(uv3+texsize.zw)))*inside*kstrength*r2;
comp_50=`ret *= 1-6*d;
comp_51=`ret *= 1-kstrength*pow(r2,3)*inside*.75;
comp_52=`
comp_53=`ret += saturate(0.0008*(treb_att-.2)/length (sin(uv3-.5)))*0.75*(fullk? inside:1-r2);
comp_54=`ret = 1-exp(-ret*2-.1*rad*rad);
comp_55=`ret = ret+exp(-10*length ((uv10+0.5*2*krad)))*kstrength;
comp_56=`
comp_57=`//ret = GetPixel(uv);
comp_58=`
comp_59=`}
